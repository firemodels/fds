&HEAD CHID='SC_p1_p2_60', TITLE='Solar Chimney, inlet height, cavity width, temperature'/

&TIME T_END=400. /
&DUMP DT_DEVC=1., DT_HRR=1. /

&MESH IJK= 8,60,80, XB=1.80,2.00,-0.75,0.75,0.0,2.0,MPI_PROCESS=0 / Hot cavity
&MESH IJK=20,72,24, XB=1.65,2.15,-0.90,0.90,2.0,2.6,MPI_PROCESS=1 / Cavity exit

&MESH IJK=33,36,40, XB=0.000,0.825,-0.90,0.00,0.0,1.0,MPI_PROCESS=2 / Upstream room
&MESH IJK=33,36,40, XB=0.825,1.650,-0.90,0.00,0.0,1.0,MPI_PROCESS=3 / Upstream room
&MESH IJK=33,36,40, XB=0.000,0.825,-0.90,0.00,1.0,2.0,MPI_PROCESS=4 / Upstream room
&MESH IJK=33,36,40, XB=0.825,1.650,-0.90,0.00,1.0,2.0,MPI_PROCESS=5 / Upstream room

&MESH IJK=33,36,40, XB=0.000,0.825, 0.00,0.90,0.0,1.0,MPI_PROCESS=6 / Upstream room
&MESH IJK=33,36,40, XB=0.825,1.650, 0.00,0.90,0.0,1.0,MPI_PROCESS=7 / Upstream room
&MESH IJK=33,36,40, XB=0.000,0.825, 0.00,0.90,1.0,2.0,MPI_PROCESS=8 / Upstream room
&MESH IJK=33,36,40, XB=0.825,1.650, 0.00,0.90,1.0,2.0,MPI_PROCESS=9 / Upstream room

&MESH IJK= 6,56, 4, XB=1.65,1.80,-0.70,0.70,0.0,0.1,MPI_PROCESS=10 / Inlet slot
&MESH IJK=20,40,44, XB=-0.50,0.00,-0.50,0.50,0.45,1.55,MPI_PROCESS=10 / Window

&SURF ID='HOT', COLOR='RED', TMP_FRONT=60.,EMISSIVITY=0.5 /
&SURF ID='CHIMNEY WALL', MATL_ID='AL','INS',THICKNESS=0.002,0.05, COLOR='GRAY 50' /
&SURF ID='WALL', MATL_ID='WOOD',THICKNESS=0.019, COLOR='BURNT SIENNA',DEFAULT=.TRUE. /

&MATL ID='AL',EMISSIVITY=0.05,DENSITY=2700,CONDUCTIVITY=200,SPECIFIC_HEAT=0.05/
&MATL ID='INS',DENSITY=200,CONDUCTIVITY=0.02,SPECIFIC_HEAT=0.05/
&MATL ID='WOOD',DENSITY=500,CONDUCTIVITY=1.2,SPECIFIC_HEAT=0.1/

&VENT XB= 1.80, 1.80,-0.75, 0.75,0.10,2.00, SURF_ID='HOT' / Left hot panel
&VENT XB= 2.00, 2.00,-0.75, 0.75,0.00,2.00, SURF_ID='HOT' / Right hot panel

&OBST XB=-0.05,0.00,-0.50,0.50,0.45,1.55, SURF_ID='WALL'/
&HOLE XB= -0.06,0.01,-0.25,0.25,0.7,1.3 / Window

&VENT XB=-0.50,-0.50,-0.50,0.50,0.45,1.55, SURF_ID='OPEN'/ Window outside
&VENT XB=-0.50,-0.05,-0.50,-0.50,0.45,1.55, SURF_ID='OPEN'/ Window outside
&VENT XB=-0.50,-0.05, 0.50, 0.50,0.45,1.55, SURF_ID='OPEN'/ Window outside
&VENT XB=-0.50,-0.05,-0.50, 0.50,0.45,0.45, SURF_ID='OPEN'/ Window outside
&VENT XB=-0.50,-0.05,-0.50, 0.50,1.55,1.55, SURF_ID='OPEN'/ Window outside

&VENT XB=1.65,2.15,-0.9,-0.9,2.0,2.6, SURF_ID='OPEN' / Cavity exit, front
&VENT XB=1.65,2.15, 0.9, 0.9,2.0,2.6, SURF_ID='OPEN' / Cavity exit, back
&VENT XB=1.65,1.65,-0.9, 0.9,2.0,2.6, SURF_ID='OPEN' / Cavity exit, left
&VENT XB=2.15,2.15,-0.9, 0.9,2.0,2.6, SURF_ID='OPEN' / Cavity exit, right
&VENT XB=1.55,2.15,-0.9, 0.9,2.6,2.6, SURF_ID='OPEN' / Cavity exit, top

&VENT XB=1.80,2.00,-0.75,-0.75,0.0,2.0,SURF_ID='CHIMNEY WALL'/
&VENT XB=1.80,2.00, 0.75, 0.75,0.0,2.0,SURF_ID='CHIMNEY WALL'/

&DEVC ID='mdot', QUANTITY='CONTROL VALUE',CTRL_ID='rho u int r',UNITS='kg/s'/
&DEVC ID='mdotr_i', QUANTITY='TOTAL MASS FLUX X', SPATIAL_STATISTIC='AREA INTEGRAL', XB=1.75,1.75,-0.70,0.70,0.00,0.10 /
&DEVC ID='mdotw', QUANTITY='CONTROL VALUE',CTRL_ID='rho u int w',UNITS='kg/s'/
&DEVC ID='mdotw_i', QUANTITY='TOTAL MASS FLUX X', SPATIAL_STATISTIC='AREA INTEGRAL',XB= -0.025,-0.025,-0.25,0.25,0.7,1.3 /
&DEVC ID='mdott', QUANTITY='CONTROL VALUE',CTRL_ID='rho u int t',UNITS='kg/s'/
&DEVC ID='mdott_i', QUANTITY='TOTAL MASS FLUX Z', SPATIAL_STATISTIC='AREA INTEGRAL', XB=1.80,2.00,-0.75,0.75,1.99,1.99 /
&DEVC ID='hdot', QUANTITY='CONTROL VALUE',CTRL_ID='h rho u int t',UNITS='kJ/s'/
&DEVC ID='hdott_i', QUANTITY='ENTHALPY FLUX Z', SPATIAL_STATISTIC='AREA INTEGRAL', XB=1.80,2.00,-0.75,0.75,1.99,1.99 /

&DEVC ID='NHFH1',XB=1.80, 1.80,-0.75, 0.75,0.10,2.00,QUANTITY='NET HEAT FLUX',IOR=1,SPATIAL_STATISTIC='SURFACE INTEGRAL'/
&DEVC ID='NHFH2',XB=2.00, 2.00,-0.75, 0.75,0.00,2.00,QUANTITY='NET HEAT FLUX',IOR=-1,SPATIAL_STATISTIC='SURFACE INTEGRAL'/
&DEVC ID='NHFS1',XB=1.80, 2.00,-0.75,-0.75,0.00,2.00,QUANTITY='NET HEAT FLUX',IOR=2,SPATIAL_STATISTIC='SURFACE INTEGRAL'/
&DEVC ID='NHFS2',XB=1.80, 2.00, 0.75, 0.75,0.00,2.00,QUANTITY='NET HEAT FLUX',IOR=-2,SPATIAL_STATISTIC='SURFACE INTEGRAL'/
&DEVC ID='NHFF',XB=1.80, 2.00,-0.75, 0.75,0.00,0.00,QUANTITY='NET HEAT FLUX',IOR=3,SPATIAL_STATISTIC='SURFACE INTEGRAL'/

&DEVC ID='CHFH1',XB=1.80, 1.80,-0.75, 0.75,0.10,2.00,QUANTITY='CONVECTIVE HEAT FLUX',IOR=1,SPATIAL_STATISTIC='SURFACE INTEGRAL'/
&DEVC ID='CHFH2',XB=2.00, 2.00,-0.75, 0.75,0.00,2.00,QUANTITY='CONVECTIVE HEAT FLUX',IOR=-1,SPATIAL_STATISTIC='SURFACE INTEGRAL'/
&DEVC ID='CHFS1',XB=1.80, 2.00,-0.75,-0.75,0.00,2.00,QUANTITY='CONVECTIVE HEAT FLUX',IOR=2,SPATIAL_STATISTIC='SURFACE INTEGRAL'/
&DEVC ID='CHFS2',XB=1.80, 2.00, 0.75, 0.75,0.00,2.00,QUANTITY='CONVECTIVE HEAT FLUX',IOR=-2,SPATIAL_STATISTIC='SURFACE INTEGRAL'/
&DEVC ID='CHFF',XB=1.80, 2.00,-0.75, 0.75,0.00,0.00,QUANTITY='CONVECTIVE HEAT FLUX',IOR=3,SPATIAL_STATISTIC='SURFACE INTEGRAL'/

&DEVC ID='HTCH1',XB=1.80, 1.80,-0.75, 0.75,0.10,2.00,QUANTITY='HEAT TRANSFER COEFFICIENT',IOR=1,SPATIAL_STATISTIC='MEAN'/
&DEVC ID='HTCH2',XB=2.00, 2.00,-0.75, 0.75,0.00,2.00,QUANTITY='HEAT TRANSFER COEFFICIENT',IOR=-1,SPATIAL_STATISTIC='MEAN'/
&DEVC ID='HTCS1',XB=1.80, 2.00,-0.75,-0.75,0.00,2.00,QUANTITY='HEAT TRANSFER COEFFICIENT',IOR=2,SPATIAL_STATISTIC='MEAN'/
&DEVC ID='HTCS2',XB=1.80, 2.00, 0.75, 0.75,0.00,2.00,QUANTITY='HEAT TRANSFER COEFFICIENT',IOR=-2,SPATIAL_STATISTIC='MEAN'/
&DEVC ID='HTCF',XB=1.80, 2.00,-0.75, 0.75,0.00,0.00,QUANTITY='HEAT TRANSFER COEFFICIENT',IOR=3,SPATIAL_STATISTIC='MEAN'/

&DEVC ID='rhor1', QUANTITY='DENSITY', XYZ = 1.75,-0.583,0.05,OUTPUT=F/
&DEVC ID='rhor2', QUANTITY='DENSITY', XYZ = 1.75,-0.350,0.05,OUTPUT=F/
&DEVC ID='rhor3', QUANTITY='DENSITY', XYZ = 1.75,-0.117,0.05,OUTPUT=F/
