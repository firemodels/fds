&HEAD CHID='ethylene_jet', TITLE='Sandia Jet Fire Experiments' /

&TIME T_END=30. /

&MISC HUMIDITY=39.4, P_INF=81030., TMPA=-1., POROUS_FLOOR=F /

&MESH IJK=50,50,50, XB=-25.0,-15.0,-15.0,-5.0,0,10.0, MULT_ID='mesh'  /
&MULT ID='mesh', DX=10, DY=10, DZ=10, I_UPPER=4, J_UPPER=6, K_UPPER=0 /  35 meshes
&MESH IJK=50,50,50, XB=-25.0,-15.0,-15.0,-5.0,10.,20.0, MULT_ID='mesh2'  /
&MULT ID='mesh2', DX=10, DY=10, DZ=10, I_UPPER=4, J_UPPER=3, K_UPPER=0 / 20 meshes

&VENT PBZ=0.   , SURF_ID='GROUND' /
&VENT MB='ZMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /

&WIND DIRECTION=69.4, SPEED=2.2 /

&SURF ID='GROUND', ROUGHNESS=0.5 /

&REAC FUEL = 'ETHYLENE'
      SOOT_YIELD = 0.01
      RADIATIVE_FRACTION=0.34 /

&RADI NUMBER_RADIATION_ANGLES=600, PATH_LENGTH=100 /

&DEVC ID='nozzle_1', XYZ=0,0,1, PROP_ID='nozzle', ORIENTATION=0,1,0, QUANTITY='TIME', SETPOINT=0. /

&PART ID='ethylene droplets',SPEC_ID='ETHYLENE', QUANTITIES(1:3)='PARTICLE DIAMETER','PARTICLE TEMPERATURE','PARTICLE AGE',
      DIAMETER=1000., MONODISPERSE=T, INITIAL_TEMPERATURE=-71.3, SAMPLING_FACTOR=1 /

&PROP ID='nozzle', PART_ID='ethylene droplets', MASS_FLOW_RATE=2.9, FLOW_RAMP='flow',
      PARTICLE_VELOCITY=100, SPRAY_ANGLE=0.,1., PARTICLES_PER_SECOND=20000, OFFSET=0.5, SMOKEVIEW_ID='nozzle'    /
&RAMP ID='flow', T=0., F=0. /
&RAMP ID='flow', T=2., F=1. /

&DEVC XBP=0,0,0.1,54.9,5,5, QUANTITY='HRRPUV', SPATIAL_STATISTIC='VOLUME INTEGRAL', DX=20., DY=0.1, DZ=5., POINTS=275, Y_ID='y_HRRPUL', ID='HRRPUL_1', STATISTICS_START=10. /
&CTRL ID='pct_1', FUNCTION_TYPE='PERCENTILE', INPUT_ID='HRRPUL_1', PERCENTILE=0.97 /
&DEVC ID='Length', XYZ=0,0,0, QUANTITY='CONTROL VALUE', TEMPORAL_STATISTIC='RUNNING AVERAGE', STATISTICS_START=10, CTRL_ID='pct_1', UNITS='m' /

&DEVC XBP=0,0,0,0,0.1,19.9, QUANTITY='HRRPUV', SPATIAL_STATISTIC='VOLUME INTEGRAL', DX=15., DY=15., DZ=0.1, POINTS=100, Z_ID='z_HRRPUL', ID='HRRPUL_2', STATISTICS_START=10. /
&CTRL ID='pct_2', FUNCTION_TYPE='PERCENTILE', INPUT_ID='HRRPUL_2', PERCENTILE=0.97 /
&DEVC ID='Height', XYZ=0,0,0, QUANTITY='CONTROL VALUE', TEMPORAL_STATISTIC='RUNNING AVERAGE', STATISTICS_START=10, CTRL_ID='pct_2', UNITS='m' /

&DUMP DT_DEVC=5. /

&SLCF PBX=0.1, QUANTITY='TEMPERATURE', CELL_CENTERED=T /
&SLCF PBX=0.0, QUANTITY='VELOCITY', VECTOR=T /
&SLCF PBX=0.1, QUANTITY='INTEGRATED INTENSITY', CELL_CENTERED=T /
&SLCF PBZ=1.0, QUANTITY='INTEGRATED INTENSITY', CELL_CENTERED=T /
&SLCF PBX=0.1, QUANTITY='HRRPUV', CELL_CENTERED=T /
&SLCF PBX=0.1, QUANTITY='VOLUME FRACTION', SPEC_ID='ETHYLENE', CELL_CENTERED=T /

&CATF OTHER_FILES='jet_devices.txt' /

&TAIL /
