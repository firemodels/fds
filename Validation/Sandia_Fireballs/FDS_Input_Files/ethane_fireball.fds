&HEAD CHID='ethane_fireball', TITLE='Sandia Fireballs' /

&TIME T_BEGIN=-10., T_END=20. /
&DUMP DT_HRR=0.1, DT_DEVC=0.1 /

&MESH IJK=40,40,40, XB=-50,-10,-20,20,0,40, MULT_ID='mesh' /
&MULT ID='mesh', DX=40., DY=40., DZ=40., I_UPPER=3, J_LOWER=-1, J_UPPER=2, K_UPPER=5 /

&WIND SPEED=3.8, Z_REF=2., DIRECTION=232.8,  L=-500., Z_0=0.1 /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

&RADI NUMBER_RADIATION_ANGLES=600, PATH_LENGTH=100. /

&REAC FUEL ='ETHANE',
      SOOT_YIELD=0.001,
      RADIATIVE_FRACTION=0.25 /

&VENT XB=-1.0,1.0,-1.0,1.0,0.,0., SURF_ID='INJECTION' /

&SURF ID='INJECTION', MASS_FLUX(1)=289.3, SPEC_ID(1)='ETHANE', TMP_FRONT=-32.8, RAMP_MF(1)='fuel', COLOR='RED', NO_SLIP=T /

&RAMP ID='fuel', T= 0.00, F=0.0 /
&RAMP ID='fuel', T= 0.20, F=0.0 /
&RAMP ID='fuel', T= 0.21, F=1.0 /
&RAMP ID='fuel', T= 1.21, F=1.0 /
&RAMP ID='fuel', T= 1.22, F=0.0 /

&DEVC ID='HRR_S', X_ID='x', QUANTITY='HRRPUV', XB=-49.5,109.5,20,20,120,120, POINTS=160, DX=0.5, DY=80, DZ=120, SPATIAL_STATISTIC='VOLUME INTEGRAL', TIME_HISTORY=T, OUTPUT=F /
&CTRL ID='x1', FUNCTION_TYPE='PERCENTILE', INPUT_ID='HRR_S-1', PERCENTILE=0.03 /
&CTRL ID='x2', FUNCTION_TYPE='PERCENTILE', INPUT_ID='HRR_S-1', PERCENTILE=0.97 /
&CTRL ID='D_S', FUNCTION_TYPE='SUBTRACT', INPUT_ID='x2','x1' /
&DEVC ID='D_S_max', QUANTITY='CONTROL VALUE', CTRL_ID='D_S', XYZ=0,0,0, TEMPORAL_STATISTIC='MAX', STATISTICS_START=0, UNITS='m' /
&DEVC ID='D_S_time', QUANTITY='CONTROL VALUE', CTRL_ID='D_S', XYZ=0,0,0, TEMPORAL_STATISTIC='MAX TIME', STATISTICS_START=0, UNITS='s' /

&DEVC ID='HRR_E', Y_ID='y', QUANTITY='HRRPUV', XB=30,30,-59.5,99.5,120,120, POINTS=160, DX=80, DY=0.5, DZ=120, SPATIAL_STATISTIC='VOLUME INTEGRAL', TIME_HISTORY=T, OUTPUT=F /
&CTRL ID='y1', FUNCTION_TYPE='PERCENTILE', INPUT_ID='HRR_E-1', PERCENTILE=0.03 /
&CTRL ID='y2', FUNCTION_TYPE='PERCENTILE', INPUT_ID='HRR_E-1', PERCENTILE=0.97 /
&CTRL ID='D_E', FUNCTION_TYPE='SUBTRACT', INPUT_ID='y2','y1' /
&DEVC ID='D_E_max', QUANTITY='CONTROL VALUE', CTRL_ID='D_E', XYZ=0,0,0, TEMPORAL_STATISTIC='MAX', STATISTICS_START=0, UNITS='m' /
&DEVC ID='D_E_time', QUANTITY='CONTROL VALUE', CTRL_ID='D_E', XYZ=0,0,0, TEMPORAL_STATISTIC='MAX TIME', STATISTICS_START=0, UNITS='s' /

&DEVC ID='Height', QUANTITY='HRRPUV', XB=-50,110,-60,100,0,240, SPATIAL_STATISTIC='CENTROID Z' /

&SLCF PBY=0.1, QUANTITY='TEMPERATURE', CELL_CENTERED=T /
&SLCF PBY=0.1, QUANTITY='VELOCITY', VECTOR=T /
&SLCF PBY=0.1, QUANTITY='INTEGRATED INTENSITY', CELL_CENTERED=T /
&SLCF PBZ=0.1, QUANTITY='INTEGRATED INTENSITY', CELL_CENTERED=T /
&SLCF PBY=0.1, QUANTITY='HRRPUV', CELL_CENTERED=T /
&SLCF PBY=0.1, QUANTITY='VOLUME FRACTION', SPEC_ID='ETHANE', CELL_CENTERED=T /

&BNDF QUANTITY='RADIATIVE HEAT FLUX' /

&CATF OTHER_FILES='fireball_devices.txt' /

&TAIL /

