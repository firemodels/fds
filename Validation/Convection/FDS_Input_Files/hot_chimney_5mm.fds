&HEAD CHID='hot_chimney_5mm', TITLE='Hot vertical rectangular duct' /

&TIME T_END=60. /

&MESH IJK=56,40,40, XB=-0.050,0.230,-0.500,-0.300,-0.100,0.100, MULT_ID='mesh' /
&MULT ID='mesh', DY=0.20, DZ=0.20, J_UPPER=4, K_LOWER=-1, K_UPPER=22 /

&RADI RADIATION=F /

&SURF ID='HOT', COLOR='RED', TMP_FRONT=30. /
&SURF ID='COLD', ADIABATIC=T, COLOR='BLUE' /

&OBST XB=-0.030, 0.000,-0.450, 0.450,0.000,4.000, SURF_ID6='COLD','HOT','COLD','COLD','COLD','COLD' /
&OBST XB= 0.180, 0.210,-0.450, 0.450,0.000,4.000, SURF_ID6='HOT','COLD','COLD','COLD','COLD','COLD' /
&OBST XB= 0.000, 0.180,-0.450,-0.420,0.000,4.000, SURF_ID6='COLD','COLD','COLD','HOT','COLD','COLD' /
&OBST XB= 0.000, 0.180, 0.420, 0.450,0.000,4.000, SURF_ID6='COLD','COLD','HOT','COLD','COLD','COLD' /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMIN', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

&DEVC ID='w_x', XB=0.005, 0.175, 0.000, 0.000, 4.000, 4.000, QUANTITY='W-VELOCITY', POINTS=18, X_ID='x' /
&DEVC ID='T_x', XB=0.005, 0.175, 0.000, 0.000, 4.000, 4.000, QUANTITY='TEMPERATURE', POINTS=18, HIDE_COORDINATES=T /
&DEVC ID='w_y', XB=0.090, 0.090,-0.415, 0.415, 4.000, 4.000, QUANTITY='W-VELOCITY', POINTS=84, Y_ID='y' /
&DEVC ID='T_y', XB=0.090, 0.090,-0.415, 0.415, 4.000, 4.000, QUANTITY='TEMPERATURE', POINTS=84, HIDE_COORDINATES=T /

&DEVC ID='h_avg', XB=0.000, 0.180,-0.420, 0.420, 0.000, 4.000, QUANTITY='HEAT TRANSFER COEFFICIENT', SURF_ID='HOT', SPATIAL_STATISTIC='MEAN', TEMPORAL_STATISTIC='RUNNING AVERAGE', STATISTICS_START=30. /
&DEVC ID='w_avg', XB=0.000, 0.180,-0.420, 0.420, 4.000, 4.000, QUANTITY='W-VELOCITY', SPATIAL_STATISTIC='MEAN', TEMPORAL_STATISTIC='RUNNING AVERAGE', STATISTICS_START=30. /
&DEVC ID='T_avg', XB=0.000, 0.180,-0.420, 0.420, 4.000, 4.000, QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MEAN', TEMPORAL_STATISTIC='RUNNING AVERAGE', STATISTICS_START=30. /
&DEVC ID='m_dot', XB=0.000, 0.180,-0.420, 0.420, 4.000, 4.000, QUANTITY='MASS FLUX Z', SPATIAL_STATISTIC='AREA INTEGRAL', TEMPORAL_STATISTIC='RUNNING AVERAGE', STATISTICS_START=30. /
&DEVC ID='q_dot', XB=0.000, 0.180,-0.420, 0.420, 4.000, 4.000, QUANTITY='ENTHALPY FLUX Z', SPATIAL_STATISTIC='AREA INTEGRAL', TEMPORAL_STATISTIC='RUNNING AVERAGE', STATISTICS_START=30. /

&BNDF QUANTITY='HEAT TRANSFER COEFFICIENT' /
&BNDF QUANTITY='CONVECTIVE HEAT TRANSFER REGIME' /
&BNDF QUANTITY='CONVECTIVE HEAT FLUX' /
&BNDF QUANTITY='WALL TEMPERATURE' /

&SLCF PBY=0.00, QUANTITY='TEMPERATURE', CELL_CENTERED=T /
&SLCF PBY=0.00, QUANTITY='TEMPERATURE', VECTOR=T /
&SLCF PBX=0.09, QUANTITY='TEMPERATURE', CELL_CENTERED=T /
&SLCF PBX=0.09, QUANTITY='TEMPERATURE', VECTOR=T /

&TAIL /
