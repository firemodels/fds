&HEAD CHID='Pike1_pre_9ms', TITLE='Crown Fire case' /

&MESH IJK=50,50,50, XB=500,550,50,100,0,50, MULT_ID='mesh' /
&MULT ID='mesh', DX=50., DY=50., I_UPPER=11, J_UPPER=5, K_UPPER=0 /

&TRNZ IDERIV=1, CC=0., PC=0.5, MESH_NUMBER=0 /
&TRNZ IDERIV=2, CC=0., PC=0.0, MESH_NUMBER=0 /

&TIME T_END=1000. /

&MISC TMPA=25., SIMULATION_MODE='SVLES' /

&SURF ID='INFLOW',VEL= -9.0,RAMP_V='time ramp', PROFILE='ATMOSPHERIC', Z0=20.,PLE=0.143 /

&RAMP ID='time ramp', T= 0.0, F=0.0 /
&RAMP ID='time ramp', T=10.0, F=1.0 /

&VENT PBX=500., SURF_ID='INFLOW' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='MIRROR' /
&VENT MB='YMAX', SURF_ID='MIRROR' /
&VENT MB='ZMAX', SURF_ID='MIRROR' /

&SURF ID='IGN FIRE', HRRPUA=500., COLOR='RED', RAMP_Q='fireramp' /
&RAMP ID='fireramp', T= 0., F=0. /
&RAMP ID='fireramp', T= 2., F=1. /
&RAMP ID='fireramp', T=30., F=1. /
&RAMP ID='fireramp', T=31., F=0. /
&OBST XB=680,683,50,350,0.0,0.1, SURF_ID='IGN FIRE'/

&CATF OTHER_FILES='vegetation_model.txt' /

&SURF ID                      = 'Ground Vegetation'
      DEFAULT                 = .TRUE.
      MINIMUM_BURNOUT_TIME    = 20.
      MATL_ID(1,1)            = 'GENERIC VEGETATION'
      MATL_ID(2,1)            = 'Soil'
      MOISTURE_CONTENT(1)    = 0.05
      SURFACE_VOLUME_RATIO(1) = 5710.
      MASS_PER_VOLUME(1)        = 12.24
      THICKNESS(1:2)          = 0.06,0.1 /

&SURF ID                   = 'Generic Foliage'
      MATL_ID              = 'GENERIC VEGETATION'
      MOISTURE_CONTENT    = 1.0 
      SURFACE_VOLUME_RATIO = 4000.
      LENGTH               = 0.05
      GEOMETRY             = 'CYLINDRICAL' /

&MATL ID='Soil'
      CONDUCTIVITY = 0.25
      SPECIFIC_HEAT = 2.
      DENSITY = 1300. /

&PART ID             = 'Generic Foliage'
      DRAG_COEFFICIENT = 2.8
      COLOR          = 'FOREST GREEN'
      SURF_ID        = 'Generic Foliage'
      QUANTITIES     = 'PARTICLE TEMPERATURE','PARTICLE MASS'
      STATIC         = .TRUE. /

&DUMP DT_HRR=1., DT_DEVC=1., SIG_FIGS=4, SIG_FIGS_EXP=2 /

&DEVC ID='x', QUANTITY='TEMPERATURE', SPATIAL_STATISTIC='MAXLOC X', XB=690,1000,205,210,0,10, SETPOINT=950. /
&CTRL ID='kill', FUNCTION_TYPE='KILL', INPUT_ID='x' /
&DEVC ID='U10', QUANTITY='VELOCITY', XYZ=501.,201.,10. /

&SLCF PBY=201., QUANTITY='TEMPERATURE', VECTOR=.TRUE. /
&SLCF PBY=201., QUANTITY='VELOCITY' /

&BNDF QUANTITY='WALL TEMPERATURE', CELL_CENTERED=.TRUE. /
&BNDF QUANTITY='BURNING RATE', CELL_CENTERED=.TRUE. /

&INIT PART_ID='Generic Foliage', XYZ=  819.6  291.6    0.5 RADIUS= 0.5, HEIGHT= 0.9, SHAPE='CONE', N_PARTICLES_PER_CELL=1, MASS_PER_VOLUME=1.224, DRY=T /
&INIT PART_ID='Generic Foliage', XYZ=  876.7  282.0    0.5 RADIUS= 0.5, HEIGHT= 0.9, SHAPE='CONE', N_PARTICLES_PER_CELL=1, MASS_PER_VOLUME=1.224, DRY=T /
