&DEVC ID='ur1', QUANTITY='U-VELOCITY', XYZ = 1.75,-0.583,0.05,OUTPUT=F/
&DEVC ID='ur2', QUANTITY='U-VELOCITY', XYZ = 1.75,-0.350,0.05,OUTPUT=F/
