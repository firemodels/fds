&HEAD CHID='BST_FRS_3', TITLE='Cardington test BST_FRS_3 for predictive wood crib validation' /

&TIME T_END=8400, T_BEGIN=0 /

&MESH ID='MESH 1', XB=0.0,2.5,0.0,2.8,0.0,2.8, IJK=25,28,28,MULT_ID='M1'/
&MULT ID='M1',DX=2.5,DY=2.8,I_UPPER=9,J_UPPER=1/
&MESH ID='MESH 2', XB=23,25,0.0,2.8,2.8,5.6, IJK=20,28,28,MULT_ID='M2'/
&MULT ID='M2',DY=2.8,J_UPPER=1/

&DUMP SMOKE3D=.TRUE,
	DT_DEVC=10.0
	DT_HRR=10.0,
	DT_SLCF=10.0,
	DT_BNDF=10.0,
	DT_RESTART=600 /

&SPEC ID='WOOD GAS',SPECIFIC_HEAT=1.5,C=1.00,H=1.82,O=0.74/
&SPEC ID='WATER VAPOR'/

&REAC ID='WOOD GAS', FUEL='WOOD GAS',SOOT_YIELD=0.01,HEAT_OF_COMBUSTION=17500,CRITICAL_FLAME_TEMPERATURE=1337/ Gives 19 MJ/kg when char included

------------------------------------------------------------ MATERIALS & SURFACES ---------------------------------------------------

&MATL ID= 'CWALLS',
      FYI= 'journal paper: natural fires in large scale compartments'
      CONDUCTIVITY  = 0.42,
      SPECIFIC_HEAT = 0.753,
      DENSITY       = 1375. /

&MATL ID= 'CSLABS',
      FYI= 'journal paper: natural fires in large scale compartments'
      CONDUCTIVITY  = 0.1600000,
      SPECIFIC_HEAT = 1.505,
      DENSITY       = 450. /

&MATL ID= 'CERAMIC',
      FYI= 'journal paper: natural fires in large scale compartments'
      CONDUCTIVITY  = 0.020000,
      SPECIFIC_HEAT = 1.13,
      DENSITY       = 128. /

&MATL ID= 'FSAND',
      FYI= 'journal paper: natural fires in large scale compartments'
      CONDUCTIVITY  = 1.00000,
      SPECIFIC_HEAT = 0.8,
      DENSITY       = 1750. /

&MATL ID='STEEL',
      FYI= 'NUREG 1934'
      CONDUCTIVITY  = 54,
      SPECIFIC_HEAT = 0.465,
      DENSITY       = 7850. /

&MATL ID='AIR',
      CONDUCTIVITY  = 1,
      SPECIFIC_HEAT = 1,
      DENSITY       = 1. /

&MATL ID='CONCRETE',
      FYI= 'NUREG 1934'
      CONDUCTIVITY  = 1.6,
      SPECIFIC_HEAT = 0.75,
      DENSITY       = 2400. /

&SURF ID      = 'WALL',
    MATL_ID   = 'CERAMIC', 'CWALLS',
    BACKING   = 'VOID',
    THICKNESS = 0.05, 0.107
    COLOR     = 'GRAY 60' /
    DEFAULT   = .true.

&SURF ID='ROOF',
      MATL_ID='CERAMIC', 'CSLABS'
      BACKING='VOID'
      THICKNESS=0.05,0.1
      COLOR='GRAY 80' /

&SURF ID='FLOOR',DEFAULT=T,
      MATL_ID='FSAND','CONCRETE',
      THICKNESS=0.075,0.30
      COLOR='BROWN' /

&SURF ID='I-FLANGE C',
      MATL_ID='CERAMIC','STEEL','AIR','STEEL','CERAMIC',
      THICKNESS=0.03,0.0125,0.178,0.0125,0.03,
      COLOR='CYAN'/

&SURF ID='I-WEB C',
      MATL_ID='CERAMIC','AIR','STEEL','AIR','CERAMIC',
      THICKNESS=0.03,0.0953,0.0079,0.00953,0.03,
      COLOR='MAGENTA'/

&SURF ID='FLANGE C',
      MATL_ID='STEEL',
      THICKNESS=0.0125,
      COLOR='PURPLE'/

&SURF ID='WEB C',
      MATL_ID='STEEL',
      THICKNESS=0.0079,
      COLOR='YELLOW'/

&SURF ID='I-FLANGE B',
      MATL_ID='CERAMIC','STEEL','AIR','STEEL','CONCRETE',
      THICKNESS=0.02,0.0127,0.2346,0.0127,0.05,
      COLOR='CYAN'/

&SURF ID='I-WEB B',
      MATL_ID='CERAMIC','AIR','STEEL','AIR','CERAMIC',
      THICKNESS=0.02,0.06985,0.0073,0.06985,0.03,
      COLOR='MAGENTA'/

&SURF ID='FLANGE B',
      MATL_ID='STEEL',
      THICKNESS=0.00635,
      BACKING='INSULATED',
      COLOR='PURPLE'/

&SURF ID='WEB B',
      MATL_ID='STEEL',
      THICKNESS=0.00365,
      BACKING='INSULATED',
      COLOR='YELLOW'/

&SURF ID         = 'WALL2',
      MATL_ID    =  'CERAMIC','CWALLS'
      THICKNESS  = 0.05,0.215,
	   COLOR='YELLOW' /

&SURF ID         = 'WALL2O',
      MATL_ID    =  'CWALLS','CERAMIC'
      THICKNESS  = 0.215,0.05
	   COLOR='GRAY 50' /

&SURF ID='IGNITOR', HRRPUA=500, TMP_FRONT=98, RAMP_Q='IRAMP',COLOR='RED' /

&RAMP ID='IRAMP', T=0, F=0 /
&RAMP ID='IRAMP', T=40, F=1 /
&RAMP ID='IRAMP', T=65, F=1 /
&RAMP ID='IRAMP', T=80, F=0 /

Predictive wood crib surface
&SURF ID='PINE_INIT',
      MATL_ID(1,1:2)='PINE_INIT','MOISTURE_INIT'
      MATL_MASS_FRACTION(1,1:2) = 0.9,0.1
      THICKNESS = 0.05
      COLOR='INDIAN RED'
      STRETCH_FACTOR=1.2
      IGNITION_TEMPERATURE=300
      THICKNESS = 0.05
      BURN_AWAY=T
      AREA_MULTIPLIER=1.90
      HEAT_OF_VAPORIZATION=250.
      HRRPUA=320
      RAMP_Q='hramp'/

HRR ramp to control the wood burning
&RAMP ID='hramp', T=0,    F=0 	/
&RAMP ID='hramp', T=150,  F=1 /
&RAMP ID='hramp', T=200,  F=1 /
&RAMP ID='hramp', T=350,  F=0.60 /

&SURF ID='PINE'
      MATL_ID='PINE'
      MOISTURE_FRACTION=0.1
      THICKNESS = 0.05
      RGB=200,168,100
      STRETCH_FACTOR=1.2
      BURN_AWAY=T
      BLOWING=T
      AREA_MULTIPLIER=1.90	/

&MATL ID = 'PINE_INIT'
      EMISSIVITY = 0.95
      DENSITY = 360
      CONDUCTIVITY_RAMP = 'wood_k'
      SPECIFIC_HEAT_RAMP = 'wood_cp'/

&MATL ID='MOISTURE_INIT'
      EMISSIVITY = 0.95
      DENSITY = 1000
      SPECIFIC_HEAT_RAMP = 'h2o_cp'
      CONDUCTIVITY_RAMP = 'h2o_k'/

&MATL ID = 'PINE'
	EMISSIVITY = 0.95
	DENSITY = 360
	CONDUCTIVITY_RAMP = 'wood_k'
	SPECIFIC_HEAT_RAMP = 'wood_cp'
	N_REACTIONS = 1
	A = 2.01E3
	E = 89.73E3
  	N_S = 1.69
	NU_SPEC = 0.805
	SPEC_ID = 'WOOD GAS'
	NU_MATL = 0.195
	MATL_ID = 'CHAR'
	HEAT_OF_REACTION = 250. /

&MATL ID='CHAR'
      DENSITY=70.2
      SPECIFIC_HEAT = 1.5
      CONDUCTIVITY_RAMP = 'char_k'
      SPECIFIC_HEAT_RAMP = 'char_cp'/

&RAMP ID = 'wood_k', T = 20, F = 0.07 /measured
&RAMP ID = 'wood_k', T = 800, F = 0.37 /

&RAMP ID = 'wood_cp', T = 20., F = 0.85 /
&RAMP ID = 'wood_cp', T = 800., F = 2.73 /

&RAMP ID = 'h2o_cp',T = 20., F = 4.184 /
&RAMP ID = 'h2o_cp',T = 90., F = 4.184 /
&RAMP ID = 'h2o_cp',T =100., F = 235.751 / accounts for evaporation
&RAMP ID = 'h2o_cp',T =110., F = 0.05 / small cp since rho h2o is now zero

&RAMP ID = 'h2o_k', T = 20., F = 0.62 /
&RAMP ID = 'h2o_k', T = 90., F = 0.62 /
&RAMP ID = 'h2o_k', T =110., F = 0.10 / once water evaporates take on the wood values
&RAMP ID = 'h2o_k', T =800., F = 0.37 /

&RAMP ID = 'char_k', T = 20., F = 0.11 /
&RAMP ID = 'char_k', T = 800., F = 0.35 /

&RAMP ID = 'char_cp', T = 20, F = 0.8362226	/
&RAMP ID = 'char_cp', T = 120, F =1.4338426	/
&RAMP ID = 'char_cp', T = 220, F =2.0314626	/
&RAMP ID = 'char_cp', T = 320, F =2.6290826	/
&RAMP ID = 'char_cp', T = 420, F =3.2267026	/
&RAMP ID = 'char_cp', T = 520, F =3.8243226	/
&RAMP ID = 'char_cp', T = 620, F =4.4219426	/
&RAMP ID = 'char_cp', T = 720, F =5.0195626	/
&RAMP ID = 'char_cp', T = 800, F =5.6171826 /

&VENT XB=1.4,1.7,0.4,1.4,0,0, SURF_ID='IGNITOR' /
&VENT XB=1.4,1.7,2.3,3.3,0,0, SURF_ID='IGNITOR' /
&VENT XB=1.4,1.7,4.2,5.2,0,0, SURF_ID='IGNITOR' /

&VENT XB = 23,23, 0,5.6,   2.8,5.6, SURF_ID='OPEN' /
&VENT XB = 25,25, 0,5.6,   0.0,5.6, SURF_ID='OPEN' /
&VENT XB = 23,25, 0,5.6,   5.6,5.6, SURF_ID='OPEN' /
&VENT XB = 23,25, 0,0.0,   0.0,5.6, SURF_ID='OPEN' /
&VENT XB = 23,25, 5.6,5.6, 0.0,5.6, SURF_ID='OPEN' /

&VENT XB=0,23,0,5.6,2.8,2.8, SURF_ID='ROOF', IOR=-3 /

&VENT XB=0,23,0,0,    0,2.8, SURF_ID='WALL', IOR=+2 /
&VENT XB=0,23,5.6,5.6,0,2.8, SURF_ID='WALL', IOR=-2 /
&VENT XB=0,0, 0,5.6,  0,2.8, SURF_ID='WALL', IOR=+1 /

&OBST XB= 23.2,23.2, 0,5.6,0,1.3, SURF_ID='WALL2' /

&OBST XB= 22.7,23, 0,5.6,0,1.3, SURF_ID6='WALL2','WALL2O','WALL2','WALL2','WALL2','WALL2' /

---------------------------------------------------- Wood cribs -------------------------------------------------------

&MULT ID='C1',  DX=1, DY=0.2, DZ=0.2, I_LOWER=0, I_UPPER=0, J_LOWER=0, J_UPPER=4, K_LOWER=0, K_UPPER=1 /
&MULT ID='C2',  DX=0.2, DY=1, DZ=0.2, I_LOWER=0, I_UPPER=4, J_LOWER=0, J_UPPER=0, K_LOWER=0, K_UPPER=1 /


