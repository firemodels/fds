&CTRL ID='Row10_TC_sum', FUNCTION_TYPE = 'SUM', INPUT_ID='C10-1','C10-2','C10-3','C10-4','C10-5','C10-6','C10-7','C10-8','C10-9','C10-10','C10-11' /

&DEVC ID='C2-1', QUANTITY='THERMOCOUPLE', PROP_ID='TC', XYZ= 3.5, 0.2, 2.5 /
