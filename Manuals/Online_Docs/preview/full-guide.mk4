-- Repair two TeX4ht serialization defects before XML DOM filters run.
-- HTML fallback parsing otherwise damages adjacent math and inequalities.
-- make4ht's unanchored file:line:error search is quadratic on large clean logs.
-- Scan individual lines first, retaining its detailed parser for actual errors
-- and its fatal-error/unsupported-package checks for every run.
local original_testlogfile = Make.testlogfile
if original_testlogfile then
  Make.testlogfile = function(parameters)
    local path = mkutils.file_in_builddir(parameters.input .. '.log', parameters)
    local file = io.open(path, 'r')
    if not file then return original_testlogfile(parameters) end
    local has_error = false
    for line in file:lines() do
      if line:match('^!') or line:match('^[^:]+:%d+:.+') then
        has_error = true
        break
      end
    end
    file:close()
    if has_error then return original_testlogfile(parameters) end
    local checked = {}
    for key, value in pairs(parameters) do checked[key] = value end
    -- This affects only post-run log analysis, never the LaTeX invocation.
    checked.interaction = 'errorstopmode'
    return original_testlogfile(checked)
  end
end
Make:add("fdsprogress", function(parameters)
  io.write("[FDS-DOCS] " .. parameters.message .. "\n")
  io.flush()
  return 0
end)
if mode ~= "html-only" then
  Make:fdsprogress {message="LaTeX pass 1/3: converting chapters and appendices"}
  Make:htlatex {}
  Make:fdsprogress {message="Bibliography: resolving citations"}
  Make:biber {}
  Make:fdsprogress {message="LaTeX pass 2/3: resolving cross-references"}
  Make:htlatex {}
  Make:fdsprogress {message="LaTeX pass 3/3: finalizing references and numbering"}
  Make:htlatex {}
  Make:fdsprogress {message="Generating HTML, MathML, and SVG figures"}
else
  -- A nonempty build sequence prevents make4ht's automatic LaTeX fallback.
  Make:tex4ht {}
end

local filter = require "make4ht-filter"
Make:match("html?$", filter {function(content)
  content = content:gsub('(<mi[^>]*>[^<]*)</math>(%s*)</mi>', '%1</mi>%2</math>')
  content = content:gsub('<a[^>]-id=("page%.[^"]*")>', '<a id=%1>')
  return content
end})

-- Use the standard filters explicitly, after the serialization repair.
local domfilter = require "make4ht-domfilter"
Make:match("html?$", domfilter {
  "fixinlines", "idcolons", "joincharacters", "tablecaption", "mathmlfixes",
  "tablerows", "booktabs", "sectionid", "itemparagraphs"
})
