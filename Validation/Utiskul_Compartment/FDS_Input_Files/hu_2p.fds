&HEAD CHID='hu_2p', TITLE='Hu et al. IAFSS (2005) compartment fire Case 2 prescribed mass loss rate'/

&TIME T_END=300./

&VENT XB=0.40,0.40,-0.20,0.20,0.00,0.4, SURF_ID='OPEN' /
&OBST XB=0.20,0.22,-0.20,0.20,0.00,0.4 /
&HOLE XB=0.19,0.23,-0.20,0.20,0.39,0.4 /
&HOLE XB=0.19,0.23,-0.20,0.20,0.0,0.01 /

&VENT XB=-0.095,0.095,-0.095,0.095,0.00,0.00, XYZ=0,0,0, RADIUS=0.095, SPREAD_RATE=1000., SURF_ID='FIRE', COLOR='RED'/

&SURF ID='FIRE', SPEC_ID(1)='N-HEPTANE', MASS_FLUX(1)=0.028, RAMP_MF(1)='case2'/

&RAMP ID='case2' T=  0, F=0.18 /
&RAMP ID='case2' T= 50, F=0.75 /
&RAMP ID='case2' T=100, F=1.00 /
&RAMP ID='case2' T=150, F=1.00 /
&RAMP ID='case2' T=210, F=0.71 /
&RAMP ID='case2' T=226, F=0.21 /
&RAMP ID='case2' T=250, F=0.10 /

&CATF OTHER_FILES='common_properties.txt' /

&TAIL /
