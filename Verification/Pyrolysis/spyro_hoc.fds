&HEAD CHID='spyro_hoc'/

&MESH XB=0,1,0,1,0,1,IJK=10,10,10/
&MESH XB=2,3,0,1,0,1,IJK=10,10,10/
&MESH XB=4,5,0,1,0,1,IJK=10,10,10/
&MESH XB=6,7,0,1,0,1,IJK=10,10,10/

&MISC Y_O2_INFTY=0.0001/

&DUMP MASS_FILE=T/

&TIME T_END=50,DT=0.05/

&REAC FUEL='PROPANE',HEAT_OF_COMBUSTION=45000/

&MATL ID='MY MAT',DENSITY=100,SPECIFIC_HEAT=1,CONDUCTIVITY=1/
&MATL ID='MY MAT H',DENSITY=100,SPECIFIC_HEAT=1,CONDUCTIVITY=1,HEAT_OF_COMBUSTION=15000/

&SURF ID='H1',MATL_ID='MY MAT',THICKNESS=0.1,EXTERNAL_FLUX=50,HRRPUA=1000,TAU_Q=0,TAU_EF=0,BURN_AWAY=T,HEAT_TRANSFER_COEFFICIENT=0/
&SURF ID='H2',MATL_ID='MY MAT H',THICKNESS=0.1,EXTERNAL_FLUX=50,HRRPUA=1000,TAU_Q=0,TAU_EF=0,BURN_AWAY=T,HEAT_TRANSFER_COEFFICIENT=0/

&SURF ID='S1',MATL_ID='MY MAT',THICKNESS=0.1,EXTERNAL_FLUX=50,HRRPUA=1000,TAU_EF=0,IGNITION_TEMPERATURE=20,REFERENCE_HEAT_FLUX=50,RAMP_Q='RAMP',BURN_AWAY=T,INERT_Q_REF=T,HEAT_TRANSFER_COEFFICIENT=0,REFERENCE_HEAT_FLUX_TIME_INTERVAL=0.05/
&SURF ID='S2',MATL_ID='MY MAT H',THICKNESS=0.1,EXTERNAL_FLUX=50,HRRPUA=1000,TAU_EF=0,IGNITION_TEMPERATURE=20,REFERENCE_HEAT_FLUX=50,RAMP_Q='RAMP',BURN_AWAY=T,INERT_Q_REF=T,HEAT_TRANSFER_COEFFICIENT=0,REFERENCE_HEAT_FLUX_TIME_INTERVAL=0.05/

&OBST XB=0.4,0.5,0.4,0.5,0.4,0.5,SURF_ID='H1',BULK_DENSITY=50,COLOR='RED'/
&OBST XB=2.4,2.5,0.4,0.5,0.4,0.5,SURF_ID='H2',BULK_DENSITY=50,COLOR='ORANGE'/
&OBST XB=4.4,4.5,0.4,0.5,0.4,0.5,SURF_ID='S1',BULK_DENSITY=50,COLOR='GREEN'/
&OBST XB=6.4,6.5,0.4,0.5,0.4,0.5,SURF_ID='S2',BULK_DENSITY=50,COLOR='BLUE'/

&RAMP ID='RAMP',T=0,F=1/
&RAMP ID='RAMP',T=100,F=1/

&DEVC XB=0,1,0,1,0,1,QUANTITY='DENSITY',SPEC_ID='PROPANE',SPATIAL_STATISTIC='VOLUME INTEGRAL',ID='H1'/
&DEVC XB=2,3,0,1,0,1,QUANTITY='DENSITY',SPEC_ID='PROPANE',SPATIAL_STATISTIC='VOLUME INTEGRAL',ID='H2'/
&DEVC XB=4,5,0,1,0,1,QUANTITY='DENSITY',SPEC_ID='PROPANE',SPATIAL_STATISTIC='VOLUME INTEGRAL',ID='S1'/
&DEVC XB=6,7,0,1,0,1,QUANTITY='DENSITY',SPEC_ID='PROPANE',SPATIAL_STATISTIC='VOLUME INTEGRAL',ID='S2'/

&DEVC XYZ=0.45,0.45,0.45,QUANTITY='BULK DENSITY',SETPOINT=0.01,ID='BDH1',TRIP_DIRECTION=-1/
&DEVC XYZ=2.45,0.45,0.45,QUANTITY='BULK DENSITY',SETPOINT=0.01,ID='BDH2',TRIP_DIRECTION=-1/
&DEVC XYZ=4.45,0.45,0.45,QUANTITY='BULK DENSITY',SETPOINT=0.01,ID='BDS1',TRIP_DIRECTION=-1/
&DEVC XYZ=6.45,0.45,0.45,QUANTITY='BULK DENSITY',SETPOINT=0.01,ID='BDS2',TRIP_DIRECTION=-1/

&DEVC XYZ=0.5,0.5,0.5,QUANTITY='TIME',NO_UPDATE_DEVC_ID='BDH1',ID='TH1'/
&DEVC XYZ=2.5,0.5,0.5,QUANTITY='TIME',NO_UPDATE_DEVC_ID='BDH2',ID='TH2'/
&DEVC XYZ=4.5,0.5,0.5,QUANTITY='TIME',NO_UPDATE_DEVC_ID='BDS1',ID='TS1'/
&DEVC XYZ=6.5,0.5,0.5,QUANTITY='TIME',NO_UPDATE_DEVC_ID='BDS2',ID='TS2'/

&SLCF QUANTITY='MASS FRACTION',SPEC_ID='PROPANE',PBY=0.5,CELL_CENTERED=T/
