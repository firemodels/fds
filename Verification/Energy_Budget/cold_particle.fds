&HEAD CHID='cold_particle', TITLE='cold_particle'/

&MESH ID='Mesh01', IJK=10,10,10,    XB=0.0, 1.0, 0.0,1.0, 0.0,1.0, /

&TIME T_END=200.0,DT=0.1/
&RADI RADIATION=.FALSE./
&DUMP NFRAMES=20/

&INIT ID='Cold Particle', PART_ID='Cold Particle', N_PARTICLES=1, XYZ=0.5,0.5,0.5, /

&PART ID='Cold Particle',  STATIC=.TRUE., SAMPLING_FACTOR=1, SURF_ID='Cold Particle'/

The extinguishing agent
&SPEC ID='MY GAS',MW=28,SPECIFIC_HEAT=1,BACKGROUND=T/

&SURF ID='AD',DEFAULT=T,ADIABATIC=T/

&SURF ID='Cold Particle',
      MASS_FLUX=0.102919507,
      SPEC_ID='MY GAS',
      TMP_FRONT=-80.0,
      TAU_T = 0.0
      EMISSIVITY=0,
      HEAT_TRANSFER_COEFFICIENT=0,
      COLOR='RED',
      GEOMETRY='SPHERICAL',
      RADIUS=0.03,
      RAMP_MF='RAMP'/

&RAMP ID='RAMP', T=0.0, F=0.0/
&RAMP ID='RAMP', T=0.1, F=1.0/
&RAMP ID='RAMP', T=100.0, F=1.0/
&RAMP ID='RAMP', T=100.1, F=0.0/

&SLCF PBY=0.5,  QUANTITY='DENSITY' /
&SLCF PBY=0.5,  QUANTITY='PRESSURE'/
&SLCF PBY=0.5,  QUANTITY='TEMPERATURE'/

&DEVC ID='U',XB=0,1,0,1,0,1,QUANTITY='INTERNAL ENERGY', SPATIAL_STATISTIC='VOLUME INTEGRAL',RELATIVE=T,TIME_AVERAGED=F/

&TAIL /
