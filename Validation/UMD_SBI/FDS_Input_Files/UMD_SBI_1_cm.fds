&DEVC ID='H2O',QUANTITY='DUCT VOLUME FRACTION',SPEC_ID='WATER VAPOR',DUCT_ID='Exhaust D',SMOOTHING_TIME=1,TIME_HISTORY=F/
&DEVC ID='T',QUANTITY='DUCT TEMPERATURE',DUCT_ID='Exhaust D',SMOOTHING_TIME=1,TIME_HISTORY=F/
&DEVC ID='VF',QUANTITY='DUCT VOLUME FLOW',DUCT_ID='Exhaust D',SMOOTHING_TIME=1,TIME_HISTORY=F/
&DEVC ID='MF',QUANTITY='DUCT MASS FLOW',DUCT_ID='Exhaust D',SMOOTHING_TIME=1,TIME_HISTORY=F/
&DEVC ID='CO_MF',QUANTITY='DUCT MASS FLOW',SPEC_ID='CARBON MONOXIDE',DUCT_ID='Exhaust D',SMOOTHING_TIME=1,TIME_HISTORY=F/

! NIST TN-2077 Method
! Eq 6 NIST TN-2077
&CTRL ID='sCOCO2',FUNCTION_TYPE='SUBTRACT',INPUT_ID='CONSTANT','CO2','CO',CONSTANT=1/
&CTRL ID='O2_sCOCO2',FUNCTION_TYPE='MULTIPLY',INPUT_ID='O2amb','sCOCO2'/
&CTRL ID='omCO2',FUNCTION_TYPE='SUBTRACT',INPUT_ID='CONSTANT','CO2amb',CONSTANT=1/
&CTRL ID='O2omCO2',FUNCTION_TYPE='MULTIPLY',INPUT_ID='O2','omCO2'/
&CTRL ID='ODFnum',FUNCTION_TYPE='SUBTRACT',INPUT_ID='O2_sCOCO2','O2omCO2'/
&CTRL ID='sALL',FUNCTION_TYPE='SUBTRACT',INPUT_ID='CONSTANT','CO2','CO','O2',CONSTANT=1/
&CTRL ID='ODFden',FUNCTION_TYPE='MULTIPLY',INPUT_ID='O2amb','sALL'/
&CTRL ID='ODF1',FUNCTION_TYPE='DIVIDE',INPUT_ID='ODFnum','ODFden'/
&CTRL ID='ODF',FUNCTION_TYPE='MAX',INPUT_ID='CONSTANT','ODF1',CONSTANT=0/

&CTRL ID='N2d',FUNCTION_TYPE='MULTIPLY',INPUT_ID='N2wamb','CONSTANT',CONSTANT=28.0134/
&CTRL ID='O2d',FUNCTION_TYPE='MULTIPLY',INPUT_ID='O2wamb','CONSTANT',CONSTANT=31.9988/
&CTRL ID='CO2d',FUNCTION_TYPE='MULTIPLY',INPUT_ID='CO2wamb','CONSTANT',CONSTANT=44.0095/
&CTRL ID='H2Od',FUNCTION_TYPE='MULTIPLY',INPUT_ID='H2Oamb','CONSTANT',CONSTANT=18.01528/
&CTRL ID='MW',FUNCTION_TYPE='SUM',INPUT_ID='N2d','O2d','CO2d','H2Od'/
&CTRL ID='MWrat',FUNCTION_TYPE='DIVIDE',INPUT_ID='CONSTANT','MW',CONSTANT=31.9988/

! Eq 12 NIST TN-2077
&CTRL ID='DHO2term',FUNCTION_TYPE='MULTIPLY',INPUT_ID='CONSTANT','ODF',CONSTANT=13100/
&CTRL ID='omODF',FUNCTION_TYPE='SUBTRACT',INPUT_ID='CONSTANT','ODF',CONSTANT=1/
&CTRL ID='omODFo2',FUNCTION_TYPE='DIVIDE',INPUT_ID='omODF','CONSTANT',CONSTANT=2/
&CTRL ID='COoO2',FUNCTION_TYPE='DIVIDE',INPUT_ID='CO','O2'/
&CTRL ID='COterm',FUNCTION_TYPE='MULTIPLY',INPUT_ID='CONSTANT','omODFo2','COoO2',CONSTANT=4586.59/
&CTRL ID='DHO2',FUNCTION_TYPE='SUBTRACT',INPUT_ID='DHO2term','COterm'/
&CTRL ID='omH2O',FUNCTION_TYPE='SUBTRACT',INPUT_ID='CONSTANT','H2Oamb',CONSTANT=1/
&CTRL ID='ODFam1',FUNCTION_TYPE='MULTIPLY',INPUT_ID='CONSTANT','ODF',CONSTANT=0.1/
&CTRL ID='odfden2',FUNCTION_TYPE='SUM',INPUT_ID='CONSTANT','ODFam1',CONSTANT=1/
&CTRL ID='MFodfden',FUNCTION_TYPE='DIVIDE',INPUT_ID='MF','odfden2'/
&CTRL ID='hoodq',FUNCTION_TYPE='MULTIPLY',INPUT_ID='DHO2','MFodfden','omH2O','O2amb','MWrat'/

&CTRL ID='omH2O',FUNCTION_TYPE='SUBTRACT',INPUT_ID='CONSTANT','H2Oamb',CONSTANT=1/
&CTRL ID='ODFam1',FUNCTION_TYPE='MULTIPLY',INPUT_ID='CONSTANT','ODF',CONSTANT=0.1/
&CTRL ID='odfden2',FUNCTION_TYPE='SUM',INPUT_ID='CONSTANT','ODFam1',CONSTANT=1/
&CTRL ID='MFodfden',FUNCTION_TYPE='DIVIDE',INPUT_ID='MF','odfden2'/
&CTRL ID='hoodq',FUNCTION_TYPE='MULTIPLY',INPUT_ID='CONSTANT','ODF','MFodfden','omH2O','O2amb','MWrat',CONSTANT=13100/

! Remove CO2 from O2 measurement https://doi.org/10.1016/j.polymdegradstab.2020.109433
&CTRL ID='omCCOCO2',FUNCTION_TYPE='SUBTRACT',INPUT_ID='CONSTANT','CO2','CO','SOOT',CONSTANT=1/
&CTRL ID='O2adj',FUNCTION_TYPE='DIVIDE',INPUT_ID='O2','omCCOCO2'/
&CTRL ID='omCO2amb',FUNCTION_TYPE='SUBTRACT',INPUT_ID='CONSTANT','CO2amb',CONSTANT=1/
&CTRL ID='O2ambadj',FUNCTION_TYPE='DIVIDE',INPUT_ID='O2amb','omCO2amb'/

! MaCFP Repo Method
! Eq 1 https://doi.org/10.1016/j.polymdegradstab.2020.109433
&CTRL ID='omO2amb',FUNCTION_TYPE='SUBTRACT',INPUT_ID='CONSTANT','O2ambadj',CONSTANT=1/
&CTRL ID='1mO2pO2',FUNCTION_TYPE='SUM',INPUT_ID='omO2amb','O2adj'/
&CTRL ID='O2oO2',FUNCTION_TYPE='DIVIDE',INPUT_ID='O2ambadj','1mO2pO2'/
&CTRL ID='O2Tpar',FUNCTION_TYPE='SUBTRACT',INPUT_ID='O2oO2','O2adj'/
&CTRL ID='O2Tgam',FUNCTION_TYPE='MULTIPLY',INPUT_ID='CONSTANT','O2Tpar',CONSTANT=1.5/
&CTRL ID='rH2OO2',FUNCTION_TYPE='MULTIPLY',INPUT_ID='rH2O','O2adj'/
&CTRL ID='O2Tde',FUNCTION_TYPE='SUM',INPUT_ID='CONSTANT','O2Tgam','rH2OO2',CONSTANT=1/
&CTRL ID='O2T',FUNCTION_TYPE='DIVIDE',INPUT_ID='O2adj','O2Tde'/

! Eq 2 https://doi.org/10.1016/j.polymdegradstab.2020.109433
&CTRL ID='rdenom',FUNCTION_TYPE='MULTIPLY',INPUT_ID='O2ambadj','omH2O'/
&CTRL ID='rH2O',FUNCTION_TYPE='DIVIDE',INPUT_ID='H2Oamb','rdenom',CONSTANT=1/

! Eq 3 https://doi.org/10.1016/j.polymdegradstab.2020.109433
&CTRL ID='rH2OO2amb',FUNCTION_TYPE='MULTIPLY',INPUT_ID='rH2O','O2ambadj'/
&CTRL ID='oprH2OO2amb',FUNCTION_TYPE='SUM',INPUT_ID='CONSTANT','rH2OO2amb',CONSTANT=1/
&CTRL ID='O2ambrat',FUNCTION_TYPE='DIVIDE',INPUT_ID='O2ambadj','oprH2OO2amb'/
&CTRL ID='O2sub1',FUNCTION_TYPE='SUBTRACT',INPUT_ID='O2ambrat','O2T'/
&CTRL ID='O2sub',FUNCTION_TYPE='MAX',INPUT_ID='CONSTANT','O2sub1',CONSTANT=0/
&CTRL ID='hoodqD',FUNCTION_TYPE='MULTIPLY',INPUT_ID='CONSTANT','MF','MWrat','O2sub',CONSTANT=13100/

&BNDF QUANTITY='GAUGE HEAT FLUX',CELL_CENTERED=T/
&BNDF QUANTITY='WALL TEMPERATURE',CELL_CENTERED=T/
&BNDF QUANTITY='BURNING RATE',CELL_CENTERED=T/

&SLCF QUANTITY='TEMPERATURE',CELL_CENTERED=T,PBY=0.05/
&SLCF QUANTITY='HRRPUV',CELL_CENTERED=T,PBY=0.05/
&SLCF QUANTITY='VELOCITY',VECTOR=T,PBY=0.05/

&TAIL /
