&DEVC ID='O2amb',QUANTITY='VOLUME FRACTION',SPEC_ID='OXYGEN',DRY=T,XYZ=-0.60,-0.80,0.10,TIME_HISTORY=F/
&DEVC ID='CO2amb',QUANTITY='VOLUME FRACTION',SPEC_ID='CARBON DIOXIDE',DRY=T,XYZ=-0.60,-0.80,-0.10,TIME_HISTORY=F/
