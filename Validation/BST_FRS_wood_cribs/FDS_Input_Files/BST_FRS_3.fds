&OBST XB=2.0,3.0,0.8,1.0,2.5,2.8,SURF_ID6='I-WEB B','I-WEB B','I-WEB B','I-WEB B','I-FLANGE B','I-FLANGE B'/
&OBST XB=2.0,3.0,3.6,3.8,2.5,2.8,SURF_ID6='WEB B','WEB B','WEB B','WEB B','FLANGE B','FLANGE B'/

&OBST XB=11,12,1.8,2.0,2.5,2.8,SURF_ID6='I-WEB B','I-WEB B','I-WEB B','I-WEB B','I-FLANGE B','I-FLANGE B'/
&OBST XB=11,12,4.6,4.8,2.5,2.8,SURF_ID6='WEB B','WEB B','WEB B','WEB B','FLANGE B','FLANGE B'/

&OBST XB=19.0,20.0,0.8,1.0,2.5,2.8,SURF_ID6='I-WEB B','I-WEB B','I-WEB B','I-WEB B','I-FLANGE B','I-FLANGE B'/
&OBST XB=19.0,20.0,3.6,3.8,2.5,2.8,SURF_ID6='WEB B','WEB B','WEB B','WEB B','FLANGE B','FLANGE B'/

&OBST XB=23.0,23.6,2.5,3.1,0.0,5.6,SURF_ID='I-FLANGE C'/

---------------------------------------------- DEVICES -----------------------------------

BNDF QUANTITY='WALL TEMPERATURE' /
BNDF QUANTITY='BURNING RATE' /
BNDF QUANTITY='NET HEAT FLUX' /

SLCF PBY=2.8, QUANTITY='VOLUME FRACTION', SPEC_ID='WOOD GAS'/
SLCF PBY=2.8, QUANTITY='VOLUME FRACTION', SPEC_ID='OXYGEN' /
&SLCF PBY=2.8, QUANTITY='TEMPERATURE'/ VECTOR=.TRUE./
SLCF PBY=2.8, QUANTITY='HRRPUV'/

&PROP ID='TC', DIAMETER=0.003 /

Output row averages
&DEVC ID = 'C02_ave', QUANTITY = 'CONTROL VALUE', CTRL_ID = 'Row02_TC_ave',UNITS='C' /
&DEVC ID = 'C06_ave', QUANTITY = 'CONTROL VALUE', CTRL_ID = 'Row06_TC_ave',UNITS='C' /
&DEVC ID = 'C10_ave', QUANTITY = 'CONTROL VALUE', CTRL_ID = 'Row10_TC_ave',UNITS='C' /

Column flange averages
&DEVC ID = 'C2N_ave', QUANTITY = 'CONTROL VALUE', CTRL_ID = 'C2N_TC_ave',UNITS='C' /
&DEVC ID = 'C2S_ave', QUANTITY = 'CONTROL VALUE', CTRL_ID = 'C2S_TC_ave',UNITS='C' /
&DEVC ID = 'C6N_ave', QUANTITY = 'CONTROL VALUE', CTRL_ID = 'C6N_TC_ave',UNITS='C' /
&DEVC ID = 'C6S_ave', QUANTITY = 'CONTROL VALUE', CTRL_ID = 'C6S_TC_ave',UNITS='C' /
&DEVC ID = 'C10N_ave', QUANTITY = 'CONTROL VALUE', CTRL_ID = 'C10N_TC_ave',UNITS='C' /
&DEVC ID = 'C10S_ave', QUANTITY = 'CONTROL VALUE', CTRL_ID = 'C10S_TC_ave',UNITS='C' /

Beam bottom flange
&DEVC XYZ=2.5,0.9,2.5, ID='B2N', QUANTITY='INSIDE WALL TEMPERATURE', DEPTH=0.2, IOR=-3/
&DEVC XYZ=2.5,3.7,2.5, ID='B2S', QUANTITY='WALL TEMPERATURE', IOR=-3/
&DEVC XYZ=11.5,1.9,2.5, ID='B6N', QUANTITY='INSIDE WALL TEMPERATURE', DEPTH=0.2, IOR=-3/
&DEVC XYZ=11.5,4.7,2.5, ID='B6S', QUANTITY='WALL TEMPERATURE', IOR=-3/
&DEVC XYZ=19.5,0.9,2.5, ID='B10N', QUANTITY='INSIDE WALL TEMPERATURE', DEPTH=0.2, IOR=-3/
&DEVC XYZ=19.5,3.7,2.5, ID='B10S', QUANTITY='WALL TEMPERATURE', IOR=-3/

Calculate row averages
&CTRL ID='Row02_TC_ave', FUNCTION_TYPE = 'DIVIDE', INPUT_ID='Row02_TC_sum','CONSTANT', CONSTANT = 11 /
&CTRL ID='Row06_TC_ave', FUNCTION_TYPE = 'DIVIDE', INPUT_ID='Row06_TC_sum','CONSTANT', CONSTANT = 11 /
&CTRL ID='Row10_TC_ave', FUNCTION_TYPE = 'DIVIDE', INPUT_ID='Row10_TC_sum','CONSTANT', CONSTANT = 11 /

Calculate row sums
&CTRL ID='Row02_TC_sum', FUNCTION_TYPE = 'SUM', INPUT_ID='C2-1','C2-2','C2-3','C2-4','C2-5','C2-6','C2-7','C2-8','C2-9','C2-10','C2-11' /
